    <!-- Component Descriptions -->
    <string name="desc_battery">La fuente de toda la energía. Como un tanque de agua a presión.</string>
    <string name="desc_ground">El retorno de la energía. El punto de referencia (cero voltios).</string>
    <string name="desc_resistor">Pone freno a la energía. Protege a los componentes delicados.</string>
    <string name="desc_led">Se ilumina cuando pasa energía. ¡La recompensa visual!</string>
    <string name="desc_capacitor">Un pequeño depósito que se llena y vacía despacio. Crea retardos.</string>
    <string name="desc_switch">Tú decides cuándo pasa la energía. Abre o cierra el camino.</string>
    <string name="desc_timer555">El cerebro que crea ritmos. Hace parpadear, temporizar, repetir.</string>

